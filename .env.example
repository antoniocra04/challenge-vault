# ---------------------------------------------------------------------------
# Challenge Vault configuration
# Copy to .env and adjust:  cp .env.example .env
# ---------------------------------------------------------------------------

# Port the app is published on (http://localhost:3000)
APP_PORT=3000

# Optional single-user password. Leave empty to run without login
# (fine on a trusted home network / behind your own reverse proxy auth).
APP_PASSWORD=

# Set to true when the vault is served over HTTPS, so the session cookie is
# marked Secure.
COOKIE_SECURE=false

# PostgreSQL credentials used by docker compose
POSTGRES_USER=vault
POSTGRES_PASSWORD=change-me
POSTGRES_DB=challenge_vault

# Fill an empty vault with the four example challenges on first start.
SEED_DEMO_DATA=false

# Maximum size of a single uploaded attachment, in megabytes.
MAX_UPLOAD_MB=50

# Timezone used for dates in exports and logs.
TZ=UTC

# --- Local development only (npm run dev) ---------------------------------
# Docker compose builds DATABASE_URL from the POSTGRES_* values above.
DATABASE_URL=postgres://vault:change-me@localhost:5432/challenge_vault
UPLOAD_DIR=./data/uploads
# Disposable database for `npm test` integration tests (optional).
TEST_DATABASE_URL=
NEXT_TELEMETRY_DISABLED=1
